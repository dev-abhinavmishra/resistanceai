# ResistanceAI environment configuration
# Copy to .env and fill in values as needed. Every variable is optional —
# unset values fall back to development defaults documented below.

# --- Model & data locations -------------------------------------------------
# Directory containing resistance_model_v2.pkl + metrics JSONs.
# The trained artifact is gitignored (CC BY-NC-ND derivative); regenerate via
# backend/models/ingest_v2.py + backend/models/train_v2.py.
# RESISTANCEAI_MODEL_DIR=backend/artifacts

# Directory containing patient_records.jsonl + feature_matrix.parquet.
# Required for corpus-backed features (digital twins, cohort analytics,
# real-patient worklist); inference still works without it.
# RESISTANCEAI_DATA_DIR=backend/data

# --- API security (backend/main.py) -----------------------------------------
# If set, POST /predict, /predict/batch, /cohort/query and GET /model/info
# require header:  X-API-Key: <this value>
# Unset = open development mode (do not expose publicly).
# RESISTANCEAI_API_KEY=

# Comma-separated CORS allowlist for the Flask API. "*" is dev-only.
# RESISTANCEAI_CORS_ORIGINS=https://your-domain.example

# Set to 1 only behind a reverse proxy you control — makes rate limiting key
# on X-Forwarded-For instead of the socket address.
# RESISTANCEAI_TRUST_PROXY=0

# Max request body bytes for the API (default 5 MiB).
# RESISTANCEAI_MAX_BODY_BYTES=5242880

# Per-client sliding-window rate limits (requests/minute). 0 disables.
# RESISTANCEAI_RL_PREDICT=120
# RESISTANCEAI_RL_BATCH=10
# RESISTANCEAI_RL_COHORT=30
